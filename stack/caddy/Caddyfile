{
	auto_https off
	admin off
}

http://status.home {
	reverse_proxy uptime-kuma:3001
}

http://grafana.home {
	reverse_proxy grafana:3000
}

http://speed.home {
	reverse_proxy speedtest-tracker:80
}

http://memos.home {
	reverse_proxy memos:5230
}

# home.home, the container IP and anything else -> start page
# (push heartbeats from the host go to Uptime Kuma)
http:// {
	handle /api/push/* {
		reverse_proxy uptime-kuma:3001
	}
	handle {
		reverse_proxy homepage:3000
	}
}
