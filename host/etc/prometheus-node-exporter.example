# /etc/default/prometheus-node-exporter -- lean setup: only the collectors the dashboard uses.
# Replace <nic> with the bridge member (ip -br link). Listen on the host address so the monitor container can scrape it.
ARGS="--web.listen-address=192.168.1.10:9100 --collector.disable-defaults --collector.cpu --collector.meminfo --collector.loadavg --collector.filesystem --collector.netdev --collector.powersupplyclass --collector.hwmon --collector.stat --collector.time --collector.uname --collector.netdev.device-include=^(<nic>|vmbr0|tailscale0)$ --collector.filesystem.mount-points-exclude=^/(dev|proc|run|sys|var/lib/lxcfs|etc/pve)($|/)"
